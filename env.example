# K9 Shop Location Pages - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Add these when integrating Supabase)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Service (Brevo, Mailgun, SendGrid, etc.)
# NEXT_PUBLIC_BREVO_API_KEY=your_brevo_api_key_here
# NEXT_PUBLIC_MAILGUN_API_KEY=your_mailgun_api_key_here
# NEXT_PUBLIC_SENDGRID_API_KEY=your_sendgrid_api_key_here

# Analytics (Optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your_fb_pixel_id_here

# API Keys (For future integrations)
# NEXT_PUBLIC_OPENAI_API_KEY=your_openai_key_here (if using AI features)
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here (if adding maps)

# Feature Flags
# NEXT_PUBLIC_ENABLE_BLOG=true
# NEXT_PUBLIC_ENABLE_COMMENTS=false
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Database
# DATABASE_URL=your_database_url_here

# Deployment
# VERCEL_URL will be automatically set by Vercel in production
